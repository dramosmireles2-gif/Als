    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    (function () {
      var eleccion = null;
      try {
        var guardado = JSON.parse(localStorage.getItem('als:cookies') || 'null');
        if (guardado && Date.now() - guardado.fecha < 182 * 864e5) eleccion = guardado.eleccion;
      } catch (e) {}
      var valor = eleccion === 'rechazadas' ? 'denied' : 'granted';
      gtag('consent', 'default', { ad_storage: valor, ad_user_data: valor, ad_personalization: valor, analytics_storage: valor });
    })();
    gtag('js', new Date());
    gtag('config', 'AW-11262534800');
    (function () {
      var cargado = false;
      function cargar() {
        if (cargado) return;
        cargado = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-11262534800';
        document.head.appendChild(s);
      }
      ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) { addEventListener(ev, cargar, { once: true, passive: true }); });
